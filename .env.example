# =============================================================================
# TRIAD THREAD STUDIO — environment
# Copy to `.env` for local dev. In production set these in the Vercel dashboard.
# `.env` is gitignored and must never be committed.
# =============================================================================

# --- Site --------------------------------------------------------------------
# Canonical origin, no trailing slash. Drives metadata, OG tags, sitemap
# and every absolute URL in structured data.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# --- Database (Supabase → Project Settings → Database) ------------------------
# POOLED connection (port 6543, PgBouncer). Used by the running app.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT connection (port 5432). Used ONLY by the Prisma CLI for migrations —
# PgBouncer in transaction mode cannot execute DDL.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"


# --- Admin authentication ----------------------------------------------------
# Signing key for admin session JWTs. Must be at least 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this immediately invalidates every active admin session.
AUTH_SECRET=""

# Seed credentials for the first owner account. Used ONCE by `npm run db:seed`.
# Delete these from the environment after the first successful seed.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""


# --- Email (Resend → API Keys) ------------------------------------------------
RESEND_API_KEY=""
# Must be a verified sending domain in Resend, not a free mailbox.
EMAIL_FROM="Triad Thread Studio <orders@yourdomain.com>"
# Where order notifications and enquiries are delivered internally.
EMAIL_TO_INTERNAL=""


# --- Media (Cloudinary → Dashboard) -------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Unsigned preset used for customer reference-image uploads in the configurator.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
# Server-side only. Never prefix with NEXT_PUBLIC_ — that would ship it to the browser.
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
